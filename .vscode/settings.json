{
  "editor.formatOnSave": true,
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "[javascript][javascriptreact][typescript][typescriptreact][json][jsonc][json5][css][scss][less][graphql][toml][yaml][html][vue][markdown][mdx][handlebars]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "editor.codeActionsOnSave": { "source.fixAll.oxc": "explicit" },
  "prettier.requireConfig": true,
  "npm.packageManager": "pnpm",
  "files.eol": "\n",
  "files.insertFinalNewline": true,
  "files.trimTrailingWhitespace": true,
  "search.exclude": { "**/dist": true, "**/pnpm-lock.yaml": true }
}
